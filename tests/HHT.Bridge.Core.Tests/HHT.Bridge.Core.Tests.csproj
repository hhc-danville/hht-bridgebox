<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dependency-free test runner: dotnet run (project tests/HHT.Bridge.Core.Tests).
       Exit code 0 = all passed. Can be migrated to xUnit later without changing the assertions. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HHT.Bridge.Core\HHT.Bridge.Core.csproj" />
  </ItemGroup>
</Project>
